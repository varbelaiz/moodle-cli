# Campus URL (required).
MOODLE_URL=https://campusvirtual.udesa.edu.ar

# Needed only to mint a token with `moodle auth login`.
# Once the token is in your keyring, delete MOODLE_PASS.
MOODLE_USER=
MOODLE_PASS=

# Optional: use a token directly and skip the keyring entirely.
# MOODLE_TOKEN=

# Optional: enables `--ocr` in `moodle anydoc convert`/`fetch` (the anydoc plugin's
# hosted, OCR-capable conversion via Firecrawl Parse). Without it, --ocr fails clearly
# instead of falling back to local conversion.
# FIRECRAWL_KEY=
